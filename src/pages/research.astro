
---
import BaseLayout from "../layouts/BaseLayout.astro";

const researchAreas = [
  {
    number: "01",
    title: "Neural Networks for Scalable Statistical Computing",
  },
  {
    number: "02",
    title: "High-Dimensional Bayesian Model Selection",
  },
  {
    number: "03",
    title: "Neural Networks for Tabular and Noisy Data",
  },
  {
    number: "04",
    title: "Dynamic Learning under Data Drift and Distribution Shift",
  },
];

const coefficients = [
  0, 0, 27, 0, -19, 0, 0, 14,
  0, 0, -25, 0, 0, 18, 0, 0,
];

const predictionPoints = [
  [32, 91],
  [42, 87],
  [48, 74],
  [57, 81],
  [65, 64],
  [75, 68],
  [82, 57],
  [90, 48],
  [98, 55],
  [109, 37],
  [118, 41],
  [128, 28],
  [139, 32],
  [149, 19],
  [160, 23],
];
---

<BaseLayout
  title="Research"
  description="Research at Shingularity Lab, Yonsei University"
>
  <!-- PAGE TITLE -->

  <section class="research-header">
    <h1 class="page-title">Research</h1>

    <p class="intro">
      We develop statistical and machine learning methods at the intersection of
      <br />
      <strong>
        High-Dimensional Statistics, Statistical Computing, and Neural Networks.
      </strong>
      <br />
      Our current research projects and directions are summarized below.
    </p>
  </section>

  <!-- FEATURED RESEARCH -->

  <section
    class="featured-research"
    id="featured-research"
  >
    <div class="featured-label">
      FEATURED RESEARCH · ONGOING
    </div>

    <h2>
      High-Dimensional Linear Regression Foundation Model
    </h2>

    <p class="featured-subtitle">
      Learning to Estimate, Regularize, and Predict
    </p>

    <div class="featured-content">
      <p>
        Penalized linear regression is a fundamental tool for
        high-dimensional data analysis. However, conventional
        approaches require repeatedly solving optimization problems
        and selecting appropriate penalty functions and tuning
        parameters through cross-validation.
      </p>

      <p>
        We develop foundation models pretrained on diverse synthetic
        regression tasks to unify{" "}
        <strong>coefficient estimation</strong>,{" "}
        <strong>adaptive penalty learning</strong>,{" "}
        and{" "}
        <strong>response prediction</strong>.
        One network estimates penalized regression coefficients for
        a given penalty function and tuning parameter, while a
        second network learns an appropriate penalty function and
        tuning parameter directly from the observed data.
        Together, these models aim to reduce the need for repeated
        optimization and cross-validation.
      </p>

      <p>
        To enable scalable statistical computing in settings where
        the number of features far exceeds the sample size, we
        develop attention-free neural architectures that combine
        classical statistical initialization, learned refinement,
        and compact summary statistics. Our goal is to achieve
        efficient inference on ordinary CPUs with computational
        complexity that scales linearly with the number of features.
      </p>

      <p>
        Our ongoing research investigates the stability of learned
        estimators in high-dimensional settings, their dependence
        on synthetic training distributions, and their ability
        to generalize to previously unseen regression problems.
      </p>
    </div>

    <!-- =========================================
         CONCEPTUAL FRAMEWORK
         ========================================= -->

    <div
      class="framework"
      aria-label="Conceptual framework for high-dimensional linear regression foundation models"
    >
      <!-- PRETRAINING -->

      <div class="framework-training">
        <div class="framework-box training-box">
          <strong>Diverse Synthetic Regression Tasks</strong>
        </div>

        <div class="training-arrow">
          <span>↓</span>
          <small>Pretraining</small>
        </div>
      </div>

      <!-- INPUT / MODEL / OUTPUTS -->

      <div class="framework-main">

        <!-- INPUT -->

        <div class="framework-box input-box">
          <strong>Input Data</strong>
          <span>Observed (X, y)</span>
          <span>and query features</span>
        </div>

        <div class="framework-arrow">
          →
        </div>

        <!-- FOUNDATION MODEL -->

        <div class="framework-model">
          <strong>Foundation Model</strong>
          <span>Beyond Prediction</span>
          <small>Estimate · Regularize · Predict</small>
        </div>

        <!-- OUTPUT CONNECTOR -->

        <div class="output-connector">
          <svg
            viewBox="0 0 44 360"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M0 180 H20 M20 60 V300
                 M20 60 H39
                 M20 180 H39
                 M20 300 H39"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              vector-effect="non-scaling-stroke"
            />

            <path
              d="M33 55 L39 60 L33 65
                 M33 175 L39 180 L33 185
                 M33 295 L39 300 L33 305"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>

        <!-- THREE OUTPUTS -->

        <div class="framework-outputs">

          <!-- 01. COEFFICIENT ESTIMATION -->

          <div class="framework-box output-box">
            <strong>Coefficient Estimation</strong>

            <svg
              class="output-plot"
              viewBox="0 0 200 100"
              role="img"
              aria-label="Illustrative sparse regression coefficients"
            >
              <line
                x1="15" y1="50"
                x2="185" y2="50"
                class="plot-axis"
              />

              <line
                x1="15" y1="12"
                x2="15" y2="88"
                class="plot-axis"
              />

              {
                coefficients.map((value, i) => (
                  <g>
                    <line
                      x1={24 + i * 10}
                      y1="50"
                      x2={24 + i * 10}
                      y2={50 - value}
                      class="coefficient-stem"
                    />

                    <circle
                      cx={24 + i * 10}
                      cy={50 - value}
                      r={value === 0 ? 1.8 : 2.6}
                      class="coefficient-point"
                    />
                  </g>
                ))
              }

              <text
                x="100" y="98"
                text-anchor="middle"
                class="plot-label"
              >
                Feature index
              </text>
            </svg>

            <span class="output-description">
              Sparse regression coefficients
            </span>
          </div>

          <!-- 02. PENALTY FUNCTION LEARNING -->

          <div class="framework-box output-box">
            <strong>Penalty Function Learning</strong>

            <svg
              class="output-plot"
              viewBox="0 0 200 100"
              role="img"
              aria-label="Illustrative learned penalty function"
            >
              <line
                x1="24" y1="79"
                x2="183" y2="79"
                class="plot-axis"
              />

              <line
                x1="24" y1="79"
                x2="24" y2="9"
                class="plot-axis"
              />

              <!-- Illustrative L1 reference -->

              <path
                d="M24 79 L174 12"
                class="reference-curve"
              />

              <!-- Illustrative adaptive penalty -->

              <path
                d="M24 79
                   C34 58, 46 43, 64 33
                   S105 19, 132 17
                   S160 16, 174 16"
                class="penalty-curve"
              />

              <text
                x="104" y="96"
                text-anchor="middle"
                class="plot-label"
              >
                Coefficient magnitude
              </text>

              <text
                x="11" y="44"
                text-anchor="middle"
                transform="rotate(-90 11 44)"
                class="plot-label"
              >
                Penalty
              </text>
            </svg>

            <span class="output-description">
              Data-adaptive regularization
            </span>
          </div>

          <!-- 03. RESPONSE PREDICTION -->

          <div class="framework-box output-box">
            <strong>Response Prediction</strong>

            <svg
              class="output-plot"
              viewBox="0 0 200 120"
              role="img"
              aria-label="Illustrative predicted versus observed responses"
            >
              <line
                x1="25" y1="97"
                x2="179" y2="97"
                class="plot-axis"
              />

              <line
                x1="25" y1="97"
                x2="25" y2="8"
                class="plot-axis"
              />

              <path
                d="M25 97 L174 8"
                class="reference-curve"
              />

              {
                predictionPoints.map(([x, y]) => (
                  <circle
                    cx={x}
                    cy={y}
                    r="3"
                    class="prediction-point"
                  />
                ))
              }

              <text
                x="103" y="114"
                text-anchor="middle"
                class="plot-label"
              >
                Observed
              </text>

              <text
                x="11" y="53"
                text-anchor="middle"
                transform="rotate(-90 11 53)"
                class="plot-label"
              >
                Predicted
              </text>
            </svg>

            <span class="output-description">
              Out-of-sample prediction
            </span>
          </div>

        </div>
      </div>
    </div>

    <p class="framework-caption">
      Conceptual framework of our ongoing research.
      The plots are illustrative and do not represent experimental results.
    </p>

    <div class="research-keywords">
      <span>Tabular Foundation Models</span>
      <span>High-Dimensional Regression</span>
      <span>Sparse Regression</span>
      <span>Penalty Learning</span>
      <span>Statistical Computing</span>
    </div>
  </section>

  <!-- RESEARCH DIRECTIONS -->

  <section class="research-directions">
    <h2 class="directions-title">
      Research Directions
    </h2>

    <div class="research-list">
      {
        researchAreas.map((area) => (
          <article class="research-item">
            <div class="research-number">
              {area.number}
            </div>

            <h3>{area.title}</h3>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================
     PAGE HEADER
     ========================================= */

  .research-header {
    padding: 58px 0 88px;
  }

  .intro {
    max-width: 700px;

    margin: 46px 0 0;

    color: #666666;

    font-family: inherit;

    font-size: clamp(16px, 1.3vw, 20px);
    font-weight: 400;

    line-height: 1.6;
    letter-spacing: -0.02em;
  }

  .intro strong {
    color: #111111;

    font-weight: 600;
  }

  /* =========================================
     FEATURED RESEARCH
     ========================================= */

  .featured-research {
    padding: 32px 0 60px;

    border-top: 1px solid var(--line);

    scroll-margin-top: 30px;
  }

  .featured-label {
    margin-bottom: 24px;

    color: var(--yonsei-blue);

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .featured-research h2 {
    max-width: 1000px;
    margin: 0;

    font-size: clamp(30px, 4vw, 52px);
    font-weight: 500;

    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .featured-subtitle {
    margin: 18px 0 0;

    color: var(--text-secondary);

    font-size: clamp(18px, 2vw, 24px);
    letter-spacing: -0.025em;
  }

  .featured-content {
    max-width: 850px;

    margin-top: 34px;

    color: var(--text-secondary);

    font-size: 17px;
    line-height: 1.75;
  }

  .featured-content p {
    margin: 0 0 18px;
  }

  .featured-content strong {
    color: var(--text);
    font-weight: 600;
  }

  /* =========================================
     CONCEPTUAL FRAMEWORK
     ========================================= */

  .framework {
    max-width: 1050px;

    margin: 46px 0 0;
    padding: 32px 24px;

    background: #fafafa;
    border: 1px solid var(--line-light);
  }

  .framework-training {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      36px
      minmax(0, 1.2fr)
      44px
      minmax(0, 1.25fr);

    column-gap: 10px;
    justify-items: center;

    margin-bottom: 12px;
  }

  .training-box {
    grid-column: 3;

    width: 100%;
    min-height: 50px !important;
  }

  .training-box strong {
    font-weight: 500 !important;
  }

  .training-arrow {
    grid-column: 3;

    position: relative;

    margin-top: 8px;

    color: var(--text-muted);
  }

  .training-arrow span {
    font-size: 28px;
  }

  .training-arrow small {
    position: absolute;

    left: 24px;
    top: 8px;

    font-size: 12px;
    white-space: nowrap;
  }

  .framework-main {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      36px
      minmax(0, 1.2fr)
      44px
      minmax(0, 1.25fr);

    gap: 10px;
    align-items: center;
  }

  .framework-box,
  .framework-model {
    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 8px;

    min-height: 100px;
    padding: 18px 12px;

    text-align: center;

    font-size: 14px;
    line-height: 1.4;
  }

  .framework-box {
    background: #ffffff;
    border: 1px solid var(--line);

    color: var(--text-secondary);
  }

  .framework-box strong {
    color: var(--text);
    font-weight: 600;
  }

  .framework-box span {
    font-size: 13px;
  }

  .input-box {
    min-height: 135px;
  }

  .framework-model {
    min-height: 200px;

    background: var(--yonsei-blue);
    color: #ffffff;
  }

  .framework-model strong {
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 600;
  }

  .framework-model span {
    font-size: 14px;
    opacity: 0.9;
  }

  .framework-model small {
    font-size: 12px;
    opacity: 0.7;
  }

  .framework-arrow {
    color: var(--text-muted);

    font-size: 24px;
    text-align: center;
  }

  /* =========================================
     OUTPUT CONNECTOR
     ========================================= */

  .output-connector {
    align-self: stretch;

    display: flex;
    align-items: center;

    color: var(--text-muted);
  }

  .output-connector svg {
    display: block;

    width: 100%;
    height: 100%;
  }

  /* =========================================
     THREE OUTPUTS
     ========================================= */

  .framework-outputs {
    display: grid;
    grid-template-rows: repeat(3, 1fr);

    gap: 12px;
  }

  .output-box {
    min-width: 0;
    min-height: 140px;

    padding: 12px 10px;

    gap: 5px;
  }

  .output-box strong {
    font-size: 14px;
    font-weight: 600;
  }

  .output-plot {
    display: block;

    width: 100%;
    max-width: 190px;
    height: 94px;

    color: var(--yonsei-blue);
  }

  .output-box .output-description {
    color: var(--text-muted);

    font-size: 11px;
    line-height: 1.4;
  }

  /* =========================================
     SVG PLOTS
     ========================================= */

  .plot-axis {
    stroke: #b0b0b0;
    stroke-width: 0.9;
  }

  .plot-label {
    fill: #888888;

    font-family: inherit;
    font-size: 9px;
  }

  .coefficient-stem {
    stroke: var(--yonsei-blue);
    stroke-width: 1.8;
  }

  .coefficient-point {
    fill: var(--yonsei-blue);
  }

  .penalty-curve {
    fill: none;

    stroke: var(--yonsei-blue);
    stroke-width: 2.3;

    stroke-linecap: round;
  }

  .reference-curve {
    fill: none;

    stroke: #b0b0b0;
    stroke-width: 1.2;

    stroke-dasharray: 4 4;
  }

  .prediction-point {
    fill: var(--yonsei-blue);
    opacity: 0.75;
  }

  .framework-caption {
    margin: 12px 0 0;

    color: var(--text-muted);

    font-size: 13px;
    line-height: 1.5;
  }

  /* =========================================
     RESEARCH KEYWORDS
     ========================================= */

  .research-keywords {
    display: flex;
    flex-wrap: wrap;

    gap: 10px 24px;

    margin-top: 34px;

    color: var(--yonsei-blue);

    font-size: 13px;
    font-weight: 500;
  }

  /* =========================================
     RESEARCH DIRECTIONS
     ========================================= */

  .research-directions {
    margin-top: 36px;
  }

  .directions-title {
    margin: 0 0 28px;

    font-size: 28px;
    font-weight: 500;

    letter-spacing: -0.035em;
  }

  .research-list {
    border-top: 1px solid var(--line);
  }

  .research-item {
    display: grid;

    grid-template-columns:
      minmax(70px, 130px)
      minmax(0, 1fr);

    gap: 34px;

    padding: 54px 0 60px;

    border-bottom: 1px solid var(--line);
  }

  .research-number {
    padding-top: 5px;

    color: var(--yonsei-blue);

    font-family: inherit;

    font-size: 16px;
    font-weight: 700;

    letter-spacing: 0.06em;
  }

  .research-item h3 {
    max-width: 900px;

    margin: 0;

    font-family: inherit;

    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 500;

    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  /* =========================================
     MOBILE
     ========================================= */

  @media (max-width: 720px) {
    .research-header {
      padding: 46px 0 72px;
    }

    .intro {
      margin-top: 34px;

      font-size: 16px;
    }

    .featured-research {
      padding: 26px 0 42px;
    }

    .featured-research h2 {
      font-size: 34px;
    }

    .featured-content {
      font-size: 16px;
    }

    .framework {
      padding: 24px 18px;
    }

    .framework-training {
      display: flex;
      flex-direction: column;
      align-items: center;

      gap: 8px;
    }

    .training-box {
      max-width: 320px;
    }

    .framework-main {
      grid-template-columns: 1fr;

      gap: 14px;
    }

    .framework-arrow {
      transform: rotate(90deg);
    }

    .input-box {
      min-height: 100px;
    }

    .framework-model {
      min-height: 130px;
    }

    .framework-model strong {
      font-size: 20px;
    }

    .output-connector {
      justify-content: center;

      height: 30px;
    }

    .output-connector svg {
      display: none;
    }

    .output-connector::after {
      content: "↓";

      font-size: 26px;
    }

    .framework-outputs {
      grid-template-columns: 1fr;
      grid-template-rows: auto;

      gap: 12px;
    }

    .output-box {
      min-height: 150px;
    }

    .output-plot {
      max-width: 220px;
      height: 110px;
    }

    .research-keywords {
      font-size: 12px;
    }

    .research-directions {
      margin-top: 24px;
    }

    .directions-title {
      font-size: 25px;
    }

    .research-item {
      grid-template-columns: 1fr;

      gap: 16px;

      padding: 42px 0 46px;
    }

    .research-number {
      padding-top: 0;

      font-size: 14px;
    }

    .research-item h3 {
      font-size: 26px;
    }
  }
</style>
