
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-content">
      <div class="eyebrow">
        YONSEI UNIVERSITY
      </div>

      <h1>
        Shingularity<br />
        Lab
      </h1>

      <p class="description">
        High-Dimensional Statistics
        <span>×</span>
        Neural Networks
      </p>

      <section class="current-research">
        <div class="research-label">
          CURRENT RESEARCH
        </div>

        <h2>
          Foundation Models for High-Dimensional Regression
        </h2>

        <p class="research-subtitle">
          Beyond Prediction: Learning to Estimate
        </p>

        <p class="research-description">
          Developing foundation models that go beyond prediction
          to estimate regression coefficients and uncover sparse
          structures in high-dimensional data.
        </p>

        <a
          class="research-link"
          href="/research/#featured-research"
        >
          Explore our research ↗
        </a>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 178px);

    display: flex;
    flex-direction: column;

    padding: 52px 0 36px;
  }

  .hero-content {
    flex: 1;

    display: flex;
    flex-direction: column;
  }

  .hero .eyebrow {
    margin-bottom: 58px;

    font-size: 12px;
  }

  h1 {
    max-width: 900px;

    margin: 0;

    font-size: clamp(58px, 8.5vw, 118px);
    font-weight: 500;

    line-height: 0.88;
    letter-spacing: -0.07em;
  }

  .description {
    margin: 90px 0 0;

    color: #555555;

    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 400;

    letter-spacing: -0.025em;
  }

  .description span {
    padding: 0 10px;

    color: var(--yonsei-blue);
  }

  /* =========================================
     CURRENT RESEARCH
     ========================================= */

  .current-research {
    margin-top: 60px;
    padding: 25px 0 20px;

    border-top: 1px solid var(--line);
  }

  .research-label {
    margin-bottom: 18px;

    color: var(--yonsei-blue);

    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .current-research h2 {
    max-width: 1000px;
    margin: 0;

    font-size: clamp(24px, 3vw, 38px);
    font-weight: 500;

    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .research-subtitle {
    margin: 12px 0 0;

    color: var(--text-secondary);

    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .research-description {
    max-width: 740px;
    margin: 18px 0 0;

    color: var(--text-secondary);

    font-size: 16px;
    line-height: 1.65;
  }

  .research-link {
    display: inline-block;

    margin-top: 20px;

    color: var(--yonsei-blue);

    font-size: 14px;
    text-decoration: none;
  }

  .research-link:hover {
    text-decoration: underline;
  }

  :global(.site-footer) {
    margin-top: 0 !important;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: calc(100svh - 150px);

      padding: 42px 0 28px;
    }

    .hero .eyebrow {
      margin-bottom: 42px;
    }

    h1 {
      font-size: clamp(64px, 22vw, 96px);
    }

    .description {
      max-width: 300px;

      margin-top: 70px;

      font-size: 18px;
      line-height: 1.5;
    }

    .description span {
      padding: 0 5px;
    }

    .current-research {
      margin-top: 48px;
      padding-top: 22px;
    }

    .current-research h2 {
      font-size: 28px;
    }

    .research-subtitle {
      font-size: 16px;
    }

    .research-description {
      font-size: 15px;
    }
  }
</style>
