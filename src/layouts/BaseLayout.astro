---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shingularity Lab",
  description = "Shingularity Lab at Yonsei University",
} = Astro.props;

const pageTitle =
  title === "Shingularity Lab"
    ? title
    : `${title} — Shingularity Lab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{pageTitle}</title>
  </head>

  <body>
    <Header />

    <main class="site-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>